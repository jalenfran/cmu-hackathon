# Aegis - Environment Configuration
# Copy this file to .env and fill in your values
#   cp .env.example .env

# ── Required ──────────────────────────────────────────────

# Kafka/Redpanda bootstrap servers
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# Ollama LLM server URL
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model name (llama3.2:3b is fast, llama3:8b is higher quality)
OLLAMA_MODEL=llama3.2:3b

# ── Optional ──────────────────────────────────────────────

# Capital One Nessie API Key (get from http://api.nessieisreal.com/)
# Leave as-is to use mock transaction data instead
NESSIE_API_KEY=your_key_here

# Set to true to use mock transaction data (no Nessie API needed)
MOCK_MODE=true

# Neo4j graph database (optional — graph features disabled if unavailable)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=
NEO4J_PASSWORD=

# Redis cache (optional — caching disabled if unavailable)
REDIS_URL=redis://localhost:6379/0

# Slack webhooks for real-time BLOCK notifications (optional)
# Create at: api.slack.com/apps -> Incoming Webhooks -> Add New Webhook
# AI agent BLOCK verdicts post to #fraud-alerts
WEBHOOK_URL=
# Human HITL BLOCK decisions post to #human-reviews (falls back to WEBHOOK_URL if empty)
WEBHOOK_URL_HUMAN=
