# Sentinel Mosaic - Environment Configuration
# Copy this file to .env and fill in your values

# Capital One Nessie API Key (get from http://api.nessieisreal.com/)
NESSIE_API_KEY=your_key_here

# Kafka/Redpanda bootstrap servers
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# Ollama LLM server URL
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model name (default: llama3:8b, fallback: llama3.2:3b)
OLLAMA_MODEL=llama3:8b

# Set to true to use mock transaction data (no Nessie API needed)
MOCK_MODE=true
